{
  "name": "toss-react-native",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React Native bindings for toss: headless send and receive hooks and default components, using expo-camera and Skia.",
  "keywords": [
    "react-native",
    "qr-code",
    "camera",
    "air-gap",
    "offline",
    "data-transfer",
    "skia"
  ],
  "homepage": "https://github.com/khtdr/toss/tree/main/packages/react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khtdr/toss.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/khtdr/toss/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w toss-core -w toss-qr && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json",
    "test": "npm run build -w toss-core -w toss-qr && vitest run",
    "prepublishOnly": "npm run build -w toss-core -w toss-qr && rm -rf dist && npm run build"
  },
  "dependencies": {
    "toss-core": "^0.1.0",
    "toss-qr": "^0.1.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.14.0",
    "expo-brightness": "*",
    "expo-camera": "*",
    "expo-keep-awake": "*",
    "react": ">=19.0.0",
    "react-native": "*",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "expo": "~58.0.23",
    "expo-brightness": "~58.0.2",
    "expo-camera": "~58.0.14",
    "expo-keep-awake": "~58.0.3",
    "jsqr": "^1.4.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-test-renderer": "19.3.0"
  }
}

{
  "name": "toss-qr",
  "version": "0.1.0",
  "license": "MIT",
  "description": "QR carrier for toss: frame bytes to scannable text, text to module matrix, and capacity tuning.",
  "keywords": [
    "qr-code",
    "base45",
    "air-gap",
    "offline",
    "data-transfer"
  ],
  "homepage": "https://github.com/khtdr/toss/tree/main/packages/qr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khtdr/toss.git",
    "directory": "packages/qr"
  },
  "bugs": {
    "url": "https://github.com/khtdr/toss/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w toss-core && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json",
    "test": "npm run build -w toss-core && vitest run"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "toss-core": "^0.1.0"
  }
}
